---
const orbits = [
  { rx: 48, ry: 32, opacity: .58 },
  { rx: 84, ry: 59, opacity: .55 },
  { rx: 122, ry: 86, opacity: .48 },
  { rx: 162, ry: 113, opacity: .39 },
  { rx: 205, ry: 142, opacity: .31 },
];
const planets = [
  { radius: 2.7, color: "#8098aa", duration: "28s", begin: "-4s", x: 285, y: 186 },
  { radius: 3.7, color: "#99a8b2", duration: "47s", begin: "-17s", x: 201, y: 202 },
  { radius: 4.7, color: "#718a9b", duration: "71s", begin: "-29s", x: 153, y: 205 },
  { radius: 3.3, color: "#a89598", duration: "108s", begin: "-41s", x: 137, y: 233 },
];
---
<div class="orbit-wrap" data-orbit>
  <svg class="solar" viewBox="0 0 500 330" aria-hidden="true" focusable="false">
  {orbits.map(orbit => <ellipse cx="255" cy="165" rx={orbit.rx} ry={orbit.ry}
    fill="none" stroke="#c8d6df" stroke-width="1" opacity={orbit.opacity} />)}
  <circle class="sun-halo" cx="255" cy="165" r="11" fill="#dcc396" opacity=".12" />
  <circle cx="255" cy="165" r="7" fill="#d3b47e" opacity=".88" />
  <g class="moving-planets">
    {planets.map((planet, i) => {
      const { rx, ry } = orbits[i];
      return <circle r={planet.radius} fill={planet.color} opacity=".9">
        <animateMotion dur={planet.duration} repeatCount="indefinite" begin={planet.begin}
          path={`M${255 + rx} 165 A${rx} ${ry} 0 1 1 ${255 - rx} 165 A${rx} ${ry} 0 1 1 ${255 + rx} 165`} />
      </circle>;
    })}
  </g>
  <g class="still-planets">
    {planets.map(planet => <circle cx={planet.x} cy={planet.y} r={planet.radius} fill={planet.color} opacity=".9" />)}
  </g>
  </svg>
  <p class="orbit-caption">PEOPLE<br />PLACES<br />STORIES<br />AND<br />BEYOND</p>
</div>

<script>
  const orbit = document.querySelector<HTMLElement>("[data-orbit]");
  const allowMotion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    && window.matchMedia("(pointer: fine)").matches;

  if (orbit && allowMotion) {
    orbit.addEventListener("pointermove", (event) => {
      const bounds = orbit.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - .5;
      const y = (event.clientY - bounds.top) / bounds.height - .5;
      orbit.style.setProperty("--orbit-x", `${(x * 10).toFixed(2)}px`);
      orbit.style.setProperty("--orbit-y", `${(y * 8).toFixed(2)}px`);
      orbit.style.setProperty("--orbit-rotate", `${(x * .9).toFixed(2)}deg`);
    });
    orbit.addEventListener("pointerleave", () => {
      orbit.style.removeProperty("--orbit-x");
      orbit.style.removeProperty("--orbit-y");
      orbit.style.removeProperty("--orbit-rotate");
    });
  }
</script>

<style>
  .orbit-wrap { --orbit-x: 0px; --orbit-y: 0px; --orbit-rotate: 0deg; position: absolute; right: 28px; top: 48px; width: min(490px, 49vw); height: 315px; pointer-events: auto; }
  .solar { position: absolute; inset: 0; width: 100%; opacity: .82; transform: translate(var(--orbit-x), var(--orbit-y)) rotate(calc(-14deg + var(--orbit-rotate))); transform-origin: 50% 50%; transition: transform 380ms cubic-bezier(.2, .7, .2, 1), opacity 900ms ease-out; pointer-events: none; }
  .sun-halo { transform-origin: 255px 165px; }
  .orbit-caption { position: absolute; right: 4px; bottom: 0; margin: 0; color: #526575; font: 600 9px/2.45 var(--sans, sans-serif); letter-spacing: .28em; opacity: .46; pointer-events: none; }
  .still-planets { display: none; }
  @media (max-width: 800px) {
    .orbit-wrap { right: 16px; top: 32px; width: 430px; }
    .solar { opacity: .56; }
  }
  @media (max-width: 600px) {
    .orbit-wrap { position: relative; right: auto; top: auto; width: min(360px, 100%); height: 245px; margin: 34px 0 -26px auto; }
    .solar { opacity: .48; transform: rotate(-14deg); }
    .orbit-caption { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .solar { transition: none; }
    .moving-planets { display: none; }
    .still-planets { display: inline; }
  }
</style>
