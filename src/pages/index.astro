---
import { site, stations } from "../config";
import Orbit from "../components/Orbit.astro";
import "../styles/global.css";
const title = `${site.name} · ${site.subtitle}`;
const canonical = new URL("/", Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/favicon-180.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <div class="page">
      <header class="masthead" aria-label="深海客">
        <span class="wordmark">SHENHAIKE</span>
        <span class="masthead-note">文字与所见</span>
      </header>
      <main id="main">
        <section class="intro" aria-labelledby="name">
          <div class="intro-copy">
            <h1 id="name">{site.name}</h1>
            <p class="subtitle">{site.subtitle}</p>
            <p class="description">{site.description}</p>
          </div>
          <Orbit />
        </section>
        <section class="stations" aria-label="站点入口">
          {stations.map(station => (
            <article class:list={["station", { planned: station.status === "planned" }]}>
              <h2><span class="station-name">{station.name}</span><span class="station-label">· {station.label}</span></h2>
              <p>{station.description}</p>
              <div class="station-bottom">
                {station.status === "live" ? (
                  <a class="enter-link" href={station.href}>{station.action}<span aria-hidden="true">↗</span></a>
                ) : (
                  <span class="coming-soon"><span class="status-dot" aria-hidden="true"></span>{station.notice}</span>
                )}
              </div>
            </article>
          ))}
        </section>
      </main>
      <footer>
        <span>© {new Date().getFullYear()} {site.name}</span>
        <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </body>
</html>
